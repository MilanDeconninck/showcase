<header class="border-b-1 border-gray-200 mx-4 grid md:grid-cols-3 grid-cols-1 py-5">

	<!-- Profile picture with Home Page link -->
	<div class="flex flex-col items-center justify-center md:pb-5 lg:pb-0">
		<button
			class="flex items-center justify-center h-37 w-37 rounded-full bg-gradient-to-r from-gray-800 to-gray-200 dark:from-custom-blue dark:to-background-dark-secondary">
			<p>
				<a href="{{ route('index') }}">
					<img src="{{ asset('img/profielfoto-light.jpg') }}" alt="profielfoto Milan"
						class="h-35 w-35 rounded-full" />
				</a>
			</p>
		</button>
		<p class="mt-2 font-main text-lg">Milan Deconninck</p>
	</div>

	<!-- Navigation links -->
	<div
		class="sm:flex items-center justify-center sm:gap-15 text-2xl md:col-span-2 lg:col-span-1 my-3 md:my-0 text-center font-semibold">
		<p>
			<a href="{{ route('index') }}"
				class="hover:text-blue-600 md:hover:bg-gray-100 dark:hover:text-gray-100 dark:md:hover:bg-custom-blue md:p-4 rounded-lg whitespace-nowrap">Over
				Mij</a>
		</p>
		<p>
			<a href="{{ route('portfolio') }}"
				class="hover:text-blue-600 md:hover:bg-gray-100 dark:hover:text-gray-100 dark:md:hover:bg-custom-blue md:p-4 rounded-lg">Portfolio</a>
		</p>
		<p>
			<a href=""
				class="hover:text-blue-600 md:hover:bg-gray-100 dark:hover:text-gray-100 dark:md:hover:bg-custom-blue md:p-4 rounded-lg">Contact</a>
		</p>
	</div>

	<!-- Social media icons and settings -->
	<div class="flex items-center justify-center gap-5">
		<div class="w-8">
			<a href="https://www.linkedin.com/in/milan-deconnick-3b10972a6">
				{{ include("components/svgs/linkedIn.twig") }}
			</a>
		</div>
		<div class="w-8">
			<a href="https://github.com/MilanDeconninck">
				{{ include("components/svgs/github.twig") }}
			</a>
		</div>
		<div class="w-8 relative" id="settingsMenu">
			<button type="button" class="w-8 color-gray-600">
				{{ include("components/svgs/settings.twig") }}
			</button>
			<div id="dropdownSettings"
				class="hidden absolute right-0 top-full w-48 bg-white text-gray-800 dark:bg-background-dark-secondary dark:text-gray-300 shadow-lg rounded-md py-2 z-10">

				<!-- Theme switcher -->
				{% if theme == 'dark' %}
				<form method="POST" action="{{ route('theme.switch') }}">
					<input type="hidden" name="mode" value="light">
					<button type="submit"
						class="block w-full text-left px-4 py-2 hover:bg-gray-100 dark:hover:bg-custom-blue">
						Light Mode
					</button>
				</form>
				{% else %}
				<form method="POST" action="{{ route('theme.switch') }}">
					<input type="hidden" name="mode" value="dark">
					<button type="submit"
						class="block w-full text-left px-4 py-2 hover:bg-gray-100 dark:hover:bg-custom-blue">
						Dark Mode
					</button>
				</form>
				{% endif %}

				<!-- Language switcher -->
				{% if language == "en" %}
				<a href="#" class="block px-4 py-2 hover:bg-gray-100 dark:hover:bg-custom-blue">Nederlands</a>
				<a href="#" class="block px-4 py-2 hover:bg-gray-100 dark:hover:bg-custom-blue">Français</a>
				{% elseif language == "nl" %}
				<a href="#" class="block px-4 py-2 hover:bg-gray-100 dark:hover:bg-custom-blue">English</a>
				<a href="#" class="block px-4 py-2 hover:bg-gray-100 dark:hover:bg-custom-blue">Français</a>
				{% elseif language == "fr" %}
				<a href="#" class="block px-4 py-2 hover:bg-gray-100 dark:hover:bg-custom-blue">English</a>
				<a href="#" class="block px-4 py-2 hover:bg-gray-100 dark:hover:bg-custom-blue">Nederlands</a>
				{% endif %}
			</div>
		</div>
</header>