{% extends 'components/base.twig' %}
{% block title %}
Milan Deconninck
{% endblock %}

{% block content %}
<main class="xs:text-xs">
  <!-- Contact introduction section -->
  <section class="card bg-background-dark-secondary text-gray-300 p-20 xl:px-40 rounded-lg shadow-md text-center">
    <h1 class="text-3xl font-bold mb-4">{{ message("contact") }}</h1>
    <p class="text-lg card-content hidden md:block">{{ message("contactIntro") }}</p>
    <button class="toggle-btn mt-2 md:hidden text-gray-400 text-lg mx-auto border-2 rounded-lg" aria-expanded="false"
      aria-label="Show message">{{ include('components/svgs/arrowDown.twig') }}</button>
  </section>

  <!-- Contact form -->
  <section class="p-10">
    <h2 class="text-xl font-semibold mb-5">{{ message("contactForm") }}</h2>
    <form action="/contact/submit" method="POST">
      <div class="mb-4">
        <label for="name">{{ message("fullName") }}</label>
        <p>
          <input type="text" id="name" name="name" aria-invalid="true" aria-describedby="name-error"
            value="{{ old.name }}" placeholder="Milan Deconninck"
            class="bg-white border {% if errors.name %} border-red-500 {% else %} border-gray-300{% endif %} rounded-md p-2 w-full md:max-w-[80%] text-background-dark-secondary"
            required aria-required="true" />
        </p>
        {% if errors.name %}<span id="name-error" class="text-red-500 text-xs">{{ errors.name }}</span>{% endif %}
      </div>

      <div class="mb-4">
        <label for="company">{{ message("company") }}:</label>
        <p>
          <input type="text" id="company" name="company" aria-invalid="true" aria-describedby="company-error"
            value="{{ old.company }}" placeholder="{{ message('company') }}"
            class="bg-white border border-gray-300 rounded-md p-2 w-full md:max-w-[80%] text-background-dark-secondary" />
        </p>
      </div>

      <div class="mb-4">
        <label for="email">E-mail*:</label>
        <p>
          <input type="email" id="email" name="email" aria-invalid="true" aria-describedby="email-error"
            value="{{ old.email }}" placeholder="milan.deconninck@gmail.com"
            class="bg-white border {% if errors.email %} border-red-500 {% else %} border-gray-300 {% endif %} rounded-md p-2 w-full md:max-w-[80%] text-background-dark-secondary"
            required aria-required="true" />
        </p>
        {% if errors.email %}<span id="email-error" class="text-red-500 text-xs">{{ errors.email }}</span>{% endif %}
      </div>

      <div class="mb-4">
        <label for="phone">{{ message("phone") }}:</label>
        <p>
          <input type="tel" id="phone" name="phone" aria-invalid="true" aria-describedby="phone-error"
            value="{{ old.phone }}" placeholder="+32 490 00 00 00"
            class="bg-white border {% if errors.phone %} border-red-500 {% else %} border-gray-300 {% endif %} rounded-md p-2 w-full md:max-w-[80%] text-background-dark-secondary" />
        </p>
      </div>

      <div class="mb-4">
        <label for="message">{{ message("message") }}*:</label>
        <p>
          <textarea id="message" name="message" rows="5" aria-invalid="true" aria-describedby="message-error"
            class="bg-white border {% if errors.message %} border-red-500 {% else %} border-gray-300 {% endif %} rounded-md p-2 w-full md:max-w-[80%] text-background-dark-secondary"
            required aria-required="true">{{ message("messagePlaceholder") }}</textarea>
        </p>
        {% if errors.message %}<span id="message-error" class="text-red-500 text-xs">{{ errors.message }}</span>{% endif
        %}
        <p class="text-xs">* {{ message("required") }}</p>
      </div>

      <div class="mb-4">
        <button type="submit"
          class="bg-background-dark-secondary hover:bg-background-dark-tertiary dark:bg-background-dark-tertiary dark:hover:bg-custom-blue text-white font-bold py-2 px-4 rounded cursor-pointer">{{
          message("send") }}</button>
      </div>
    </form>
  </section>
</main>
{% endblock %}