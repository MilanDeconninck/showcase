{% extends 'components/base.twig' %}
{% block title %}
  Milan Deconninck
{% endblock %}

{% block content %}
  <main class="xs:text-xs">
    <!-- Welcome section -->
    <section class="card bg-background-dark-secondary text-gray-300 p-20 xl:px-40 rounded-lg shadow-md text-center">
      <h1 class="text-3xl font-bold mb-4">{{ message("welcome") }}</h1>
      <p class="text-lg card-content hidden md:block">{{ message("mainIntro") }}</p>
      <button class="toggle-btn mt-2 md:hidden text-gray-400 text-lg mx-auto border-2 rounded-lg">{{ include('components/svgs/arrowDown.twig') }}</button>
    </section>

    <!-- Background and hobbies section -->
    <section class="px-10 xl:px-20 grid lg:grid-cols-2 xl:grid-cols-3 gap-8 my-10">
      <div class="card lg:col-span-2 xl:col-span-3">
        <h1 class="py-2 text-2xl font-bold">{{ message("background") }}</h1>
        <p class="card-content hidden md:block">{{ message("backgroundText") }}</p>
        <button class="toggle-btn mt-2 md:hidden text-gray-400 text-lg mx-auto border-2 rounded-lg">{{ include('components/svgs/arrowDown.twig') }}</button>
      </div>
      <div class="lg:col-span-1 flex items-center justify-center px-10">
        <img src="{{ asset('img/judo.jpg') }}" alt="Foto van Milan in judogi" class="rounded-lg shadow-md lg:max-h-auto lg:max-h-[90%] lg:max-w-full overflow-hidden md:max-w-[50%] max-w-[80%] border-2 dark:border-background-primary" />
      </div>
      <div class="card lg:col-span-1 xl:col-span-2">
        <h2 class="pt-4 pb-2 text-xl font-bold">{{ message("hobbies") }}</h2>
        <p class="card-content hidden md:block">{{ message("hobbiesText") }}</p>
        <button class="toggle-btn mt-2 md:hidden text-gray-400 text-lg mx-auto border-2 rounded-lg">{{ include('components/svgs/arrowDown.twig') }}</button>
      </div>
    </section>

    <!-- Skills section -->
    <section class="mx-10 py-10 px-10 mt-4 mb-10 bg-background-secondary rounded-lg shadow-md dark:bg-background-dark-tertiary">
      <div class="grid md:grid-cols-3 gap-8">
        <div class="md:border-e-2">
          <h2 class="text-xl font-bold mb-2">{{ message("techSkills") }}</h2>

          <!-- List of technical skills -->
          <ul>
            <li>Visual Studio Code</li>
            <li>{{ message("php") }}</li>
            <li>HTML/CSS</li>
            <li>MySQL</li>
            <li>JavaScript</li>
          </ul>
        </div>
        <div class="md:border-e-2 border-t-2 pt-6 md:pt-0 md:border-t-0">
          <h2 class="text-xl font-bold mb-2">{{ message("softSkills") }}</h2>

          <!-- List of soft skills -->
          <ul>
            <li>{{ message("ss1") }}</li>
            <li>{{ message("ss2") }}</li>
            <li>{{ message("ss3") }}</li>
            <li>{{ message("ss4") }}</li>
            <li>{{ message("ss5") }}</li>
          </ul>
        </div>
        <div class="border-t-2 pt-6 md:pt-0 md:border-t-0">
          <h2 class="text-xl font-bold mb-2">{{ message("languages") }}</h2>

          <!-- List of languages -->
          <ul>
            <li>{{ message("dutch") }}{{ message("dutchProf") }}</li>
            <li>{{ message("english") }}{{ message("englishProf") }}</li>
            <li>{{ message("french") }}{{ message("frenchProf") }}</li>
          </ul>
        </div>
      </div>
    </section>
  </main>
{% endblock %}
