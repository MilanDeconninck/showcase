{% extends 'components/base.twig' %}
{% block title %}
  Milan Deconninck
{% endblock %}

{% block content %}
  <main class="xs:text-xs">
    <!-- Portfolio introduction section -->
    <section class="card bg-background-dark-secondary text-gray-300 p-20 xl:px-40 rounded-lg shadow-md text-center">
      <h1 class="text-3xl font-bold mb-4">{{ message('portfolio') }}</h1>
      <p class="text-lg card-content hidden md:block">{{ message('portfolioIntro') }}</p>
      <button class="toggle-btn mt-2 md:hidden text-gray-400 text-lg mx-auto border-2 rounded-lg" aria-expanded="false" aria-label="Show message">{{ include('components/svgs/arrowDown.twig') }}</button>
    </section>

    <!-- Projects section -->
    <section class="px-10 xl:px-20 mb-10 mt-4">
      <h2 class="text-2xl font-bold mt-10 mb-4">{{ message('projects') }}</h2>
      <div class="grid lg:grid-cols-2 gap-4">
        <!-- Project cards -->
        <div class="card max-w-[90%] w-full mx-auto h-full border-1 border-gray-700 dark:border-background-primary rounded-lg shadow-md p-4 flex flex-col">
          <h3 class="text-xl font-semibold bg-background-secondary dark:bg-background-dark-tertiary text-center p-2 rounded-lg">{{ message('cycling') }}</h3>
          <div class="card-content pt-2 flex-grow hidden md:block">
            <img src="{{ asset('img/wielerportaal.png') }}" alt="Cycling project screenshot" class="w-full h-auto mb-4 rounded-lg" />
            <div class="flex flex-wrap gap-2 mb-4">
              <p class="bg-gray-300 px-2 py-1 rounded">PHP</p>
              <p class="bg-gray-300 px-2 py-1 rounded">SQL</p>
              <p class="bg-gray-300 px-2 py-1 rounded">HTML</p>
              <p class="bg-gray-300 px-2 py-1 rounded">CSS</p>
              <p class="bg-gray-300 px-2 py-1 rounded">MVC</p>
              <p class="bg-gray-300 px-2 py-1 rounded">Git</p>
            </div>
            {% set github_url = "https://github.com/MilanDeconninck/Alles-in-een-wielerportaal" %}
            {% include 'components/githubLink.twig' with {'github_url': github_url} %}
          </div>
          <button class="toggle-btn mt-2 md:hidden text-gray-400 text-lg mx-auto border-2 rounded-lg" aria-expanded="false" aria-label="Show project details">{{ include('components/svgs/arrowDown.twig') }}</button>
        </div>
        <div class="card max-w-[90%] w-full mx-auto h-full border-1 border-gray-700 dark:border-background-primary rounded-lg shadow-md p-4 flex flex-col">
          <h3 class="text-xl font-semibold bg-background-secondary dark:bg-background-dark-tertiary text-center p-2 rounded-lg">{{ message('watches') }}</h3>
          <div class="card-content pt-2 flex-grow hidden md:block">
<img src="{{ asset('img/horloges.png') }}" alt="Watches project screenshot" class="w-full h-auto mb-4 rounded-lg" />
            <div class="flex flex-wrap gap-2 mb-4">
              <p class="bg-gray-300 px-2 py-1 rounded">PHP</p>
              <p class="bg-gray-300 px-2 py-1 rounded">SQL</p>
              <p class="bg-gray-300 px-2 py-1 rounded">HTML</p>
              <p class="bg-gray-300 px-2 py-1 rounded">CSS</p>
              <p class="bg-gray-300 px-2 py-1 rounded">MVC</p>
              <p class="bg-gray-300 px-2 py-1 rounded">Git</p>
              <p class="bg-gray-300 px-2 py-1 rounded">Mollie-API</p>
            </div>
            {% set github_url = "https://github.com/MilanDeconninck/E-commerce-platform-voor-horloges" %}
            {% include 'components/githubLink.twig' with {'github_url': github_url} %}
          </div>
          <button class="toggle-btn mt-2 md:hidden text-gray-400 text-lg mx-auto border-2 rounded-lg" aria-expanded="false" aria-label="Show project details">{{ include('components/svgs/arrowDown.twig') }}</button>
        </div>

        <!--   Other projects:
                - webontwikkelaar deel 2
                - Laravel jobsite
                Beide eerste uploaden op Github!
               -->

        <!-- Future projects -->
        <div class="lg:col-span-2 mt-4 text-lg italic mx-10 py-10 px-10 bg-background-secondary rounded-lg shadow-md dark:bg-background-dark-tertiary">{{ message('future') }}</div>
      </div>
    </section>
  </main>
{% endblock %}
